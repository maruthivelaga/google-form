{
  "name": "student-master-data-collection",
  "version": "1.0.0",
  "description": "Student Master Data Collection Web Application",
  "main": "backend/src/server.js",
  "scripts": {
    "seed": "node backend/scripts/seedStudents.js",
    "backend": "node backend/src/server.js",
    "dev:backend": "node --watch backend/src/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm --prefix frontend run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.11.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
